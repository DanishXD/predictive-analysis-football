# Pengecualian HANYA untuk folder deploy/ — snapshot terkurasi untuk web app
# Streamlit Community Cloud (lihat src/build_deploy_snapshot.py). Pola
# "models/" di atas match ke semua direktori bernama models, termasuk
# deploy/models/, jadi folder ini harus dikecualikan secara eksplisit
# supaya artefak web ikut ter-commit. models/ dan data/processed/ milik
# pipeline tetap di-ignore seperti semula.
!deploy/
!deploy/models/
!deploy/models/**
downloaded_files/
notebooks/figures/
.pytest_cache/

# Raw fetch blob ClubElo (regenerable dari jaringan) — sama kategori dengan
# downloaded_files/. Cache ini tidak perlu di-commit.
data/cache/

# Snapshot output pipeline per-mode untuk perbandingan rescaling before/after.
# Duplikat dari data/processed/ yang sudah di-ignore; tabel ringkasan
# rescale_compare/*.csv & *.json tetap di-commit sebagai hasil eksperimen.
data/metadata/rescale_compare/after/
data/metadata/rescale_compare/before/
